# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET=''
DJANGO_SETTINGS_MODULE=config.settings.local
ALLOWED_HOSTS=localhost,0.0.0.0,127.0.0.1

ADMINS='[["name admin A", "adminA@example.com"],["name admin B", "adminB@example.com"]]'

# Email
DEFAULT_FROM_EMAIL=''            # from-address for ordinary mail
SERVER_EMAIL=''                  # from-address for error reports (falls back to DEFAULT_FROM_EMAIL)
EMAIL_HOST=''                    # required in production
EMAIL_PORT='587'
EMAIL_HOST_USER=''               # required in production
EMAIL_HOST_PASSWORD=''           # required in production
EMAIL_USE_TLS='true'

# Database (production / config.settings.production only)
DJANGO_DB_HOST=''
DJANGO_DB_NAME=''
DJANGO_DB_USER=''
DJANGO_DB_PW=''

# OIDC / SWITCH eduID login
OIDC_RP_CLIENT_ID=''
OIDC_RP_CLIENT_SECRET=''

# Override on non-production hosts (default: https://datadonation.uzh.ch)
# WAGTAILADMIN_BASE_URL=''

# Reports

## Search Report
SEARCH_PROJECT_PK=''
SEARCH_API_KEY=''

## Digital Meal Report
DIGITALMEAL_PROJECT_PK=''
DIGITALMEAL_API_KEY=''

# Varia
ZIP_BLUEPRINT_NAME=''            # DonationBlueprint name targeted by ddl.apis.ZipPostAPI

# ZIP upload API limits (optional; sensible defaults in config/settings/base.py)
# ZIP_UPLOAD_MAX_BYTES=104857600
# ZIP_UPLOAD_MAX_UNCOMPRESSED_BYTES=524288000
# ZIP_UPLOAD_MAX_MEMBERS=1000
# ZIP_UPLOAD_MAX_COMPRESSION_RATIO=100
